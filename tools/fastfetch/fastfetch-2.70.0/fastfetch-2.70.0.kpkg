PACKAGE=fastfetch
VERSION=2.70.0
DESCRIPTION="Fast system information tool"
HOMEPAGE="https://github.com/fastfetch-cli/fastfetch"
LICENSE="MIT"
SRC_URI="https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.70.0.tar.gz -> fastfetch-2.70.0.tar.gz"
SHA256="8aa01bd3faff2be1d94f231d76489ce6d9f781f51f6e93eafe82359d6d8669af"
DEPEND="toolchain/gcc toolchain/make"
RDEPEND="system/glibc"
BUILD_FLAGS="-DBUILD_TESTS=OFF -DENABLE_SYSTEM_YYJSON=OFF"

configure() {
  cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release ${BUILD_FLAGS}
}

build() {
  cmake --build build -j"${JOBS:-$(nproc)}"
}

install() {
  DESTDIR="$DESTDIR" cmake --install build
}

post_install() {
  echo "fastfetch installed, configuration: /etc/xdg/fastfetch/config.jsonc"
}
