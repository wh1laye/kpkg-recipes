PACKAGE=rsync
VERSION=3.3.0
DESCRIPTION="Fast incremental file transfer"
HOMEPAGE="https://rsync.samba.org/"
LICENSE="GPL-3.0-or-later"
SRC_URI="https://download.samba.org/pub/rsync/src/rsync-3.3.0.tar.gz"
DEPEND="toolchain/gcc toolchain/make"
RDEPEND="system/glibc"
BUILD_FLAGS="--disable-xxhash --disable-zstd --disable-lz4 --disable-openssl --disable-md2man"
