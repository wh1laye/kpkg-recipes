PACKAGE=pkgconf
VERSION=2.3.0
DESCRIPTION="Compiler and linker flag helper"
LICENSE="ISC"
SRC_URI="https://distfiles.ariadne.space/pkgconf/pkgconf-2.3.0.tar.xz"
SHA256="3a9080ac51d03615e7c1910a0a2a8df08424892b5f13b0628a204d3fcce0ea8b"
RDEPEND="system/glibc"

install() {
  make DESTDIR="$DESTDIR" install
  ln -sf pkgconf "$DESTDIR/usr/bin/pkg-config"
}
