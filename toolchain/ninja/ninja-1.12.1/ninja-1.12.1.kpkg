PACKAGE=ninja
VERSION=1.12.1
DESCRIPTION="Small build system"
LICENSE="Apache-2.0"
SRC_URI="https://github.com/ninja-build/ninja/archive/refs/tags/v1.12.1.tar.gz -> ninja-1.12.1.tar.gz"
DEPEND="toolchain/python"
RDEPEND="system/glibc"

configure() {
  true
}

build() {
  python3 configure.py --bootstrap
}

install() {
  install -Dm755 ninja "$DESTDIR/usr/bin/ninja"
}
