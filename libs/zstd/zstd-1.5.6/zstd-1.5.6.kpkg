PACKAGE=zstd
VERSION=1.5.6
DESCRIPTION="Zstandard compression library and tools"
LICENSE="BSD-3-Clause OR GPL-2.0-only"
SRC_URI="https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-1.5.6.tar.gz"
RDEPEND="system/glibc"

configure() {
  true
}

build() {
  make prefix=/usr -j"${JOBS:-$(nproc)}"
}

install() {
  make prefix=/usr DESTDIR="$DESTDIR" install
  find "$DESTDIR/usr/lib" -name 'libzstd.a' -delete
}
