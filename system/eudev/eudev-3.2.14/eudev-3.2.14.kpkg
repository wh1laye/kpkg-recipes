PACKAGE=eudev
VERSION=3.2.14
DESCRIPTION="Device manager"
LICENSE="GPL-2.0-or-later"
SRC_URI="https://github.com/eudev-project/eudev/releases/download/v3.2.14/eudev-3.2.14.tar.gz"
