PACKAGE=openssl
VERSION=3.3.2
DESCRIPTION="TLS and cryptography toolkit"
LICENSE="Apache-2.0"
SRC_URI="https://github.com/openssl/openssl/releases/download/openssl-3.3.2/openssl-3.3.2.tar.gz"
SHA256="2e8a40b01979afe8be0bbfb3de5dc1c6709fedb46d6c89c10da114ab5fc3d281"
DEPEND="system/zlib"
RDEPEND="system/zlib system/glibc"

configure() {
  ./config --prefix=/usr --openssldir=/etc/ssl --libdir=lib shared zlib-dynamic
}

build() {
  make -j"${JOBS:-$(nproc)}"
}

install() {
  make DESTDIR="$DESTDIR" install_sw install_ssldirs
}
