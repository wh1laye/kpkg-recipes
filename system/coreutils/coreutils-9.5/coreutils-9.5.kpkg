PACKAGE=coreutils
VERSION=9.5
DESCRIPTION="GNU core utilities"
LICENSE="GPL-3.0-or-later"
SRC_URI="https://ftpmirror.gnu.org/gnu/coreutils/coreutils-9.5.tar.xz"
SHA256="cd328edeac92f6a665de9f323c93b712af1858bc2e0d88f3f7100469470a1b8a"
