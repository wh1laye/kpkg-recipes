PACKAGE=dhcpcd
VERSION=10.1.0
DESCRIPTION="DHCP client"
LICENSE="BSD-2-Clause"
SRC_URI="https://github.com/NetworkConfiguration/dhcpcd/releases/download/v10.1.0/dhcpcd-10.1.0.tar.xz"
SHA256="abc307c63853da3199baa5c1e15fd5ede9d68d068b2a59ca14c5a6768e9cc3b7"
RDEPEND="system/glibc"

configure() {
  ./configure --prefix=/usr --sysconfdir=/etc --dbdir=/var/lib/dhcpcd --runstatedir=/run
}
