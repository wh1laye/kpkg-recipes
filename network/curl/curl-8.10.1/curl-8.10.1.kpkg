PACKAGE=curl
VERSION=8.10.1
DESCRIPTION="URL transfer tool and library"
LICENSE="curl"
SRC_URI="https://curl.se/download/curl-8.10.1.tar.xz"
DEPEND="system/openssl system/zlib"
RDEPEND="system/openssl system/zlib"
BUILD_FLAGS="--with-openssl --disable-static --without-libpsl --with-ca-path=/etc/ssl/certs"
